@inherits LayoutComponentBase

<div class="min-h-screen lg:grid lg:grid-cols-[17rem_1fr]">
    <aside class="border-b border-base-300 bg-[#102a43] text-white lg:min-h-screen lg:border-b-0 lg:border-r">
        <div class="flex items-center justify-between px-5 py-5">
            <a href="/" class="flex items-center gap-3" aria-label="POS dashboard">
                <span class="grid size-10 place-items-center rounded-lg bg-warning font-mono text-lg font-black text-warning-content">P</span>
                <span>
                    <strong class="block text-lg tracking-tight">POS Ledger</strong>
                    <small class="font-mono text-[10px] uppercase tracking-[.22em] text-white/55">Static Operations</small>
                </span>
            </a>
            <details class="dropdown dropdown-end lg:hidden">
                <summary class="btn btn-sm gap-2 border-white/20 bg-white/10 text-white">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                    <span>Menu</span>
                </summary>
                <nav class="menu dropdown-content z-20 mt-2 w-64 rounded-box bg-[#102a43] p-3 shadow-xl">
                    @NavigationLinks
                </nav>
            </details>
        </div>
        <nav class="menu hidden gap-1 px-4 pb-8 text-sm lg:flex">
            @NavigationLinks
        </nav>
    </aside>

    <div class="min-w-0">
        <header class="flex min-h-20 items-center justify-between border-b border-base-300 bg-base-100 px-4 sm:px-8">
            <div>
                <p class="font-mono text-[10px] uppercase tracking-[.2em] text-primary">Operations desk</p>
                <p class="font-semibold">Inventory · Sales · Reporting</p>
            </div>
            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="flex items-center gap-3">
                        <div class="hidden text-right sm:block">
                            <p class="text-sm font-bold">@auth.User.Identity?.Name</p>
                            <p class="font-mono text-[10px] uppercase text-base-content/55">@auth.User.FindFirst("StaffCode")?.Value</p>
                        </div>
                        <LogoutForm />
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>
        <main class="mx-auto max-w-[96rem] p-4 sm:p-8">
            @Body
        </main>
    </div>
</div>

@code {
    private RenderFragment NavigationLinks => @<text>
        <li><NavLink href="/" Match="NavLinkMatch.All"><i class="fa-solid fa-gauge-high fa-fw text-white/60" aria-hidden="true"></i><span>Dashboard</span></NavLink></li>
        <li class="menu-title mt-3 text-white/45">Sell</li>
        <li><NavLink href="/sale-drafts"><i class="fa-solid fa-cart-shopping fa-fw text-white/60" aria-hidden="true"></i><span>Sale drafts</span></NavLink></li>
        <li><NavLink href="/sale-invoice-list"><i class="fa-solid fa-receipt fa-fw text-white/60" aria-hidden="true"></i><span>Invoices</span></NavLink></li>
        <li class="menu-title mt-3 text-white/45">Catalog</li>
        <li><NavLink href="/product"><i class="fa-solid fa-boxes-stacked fa-fw text-white/60" aria-hidden="true"></i><span>Products</span></NavLink></li>
        <li><NavLink href="/product-category"><i class="fa-solid fa-tags fa-fw text-white/60" aria-hidden="true"></i><span>Categories</span></NavLink></li>
        <li><NavLink href="/customer"><i class="fa-solid fa-user-group fa-fw text-white/60" aria-hidden="true"></i><span>Customers</span></NavLink></li>
        <li class="menu-title mt-3 text-white/45">Administration</li>
        <li><NavLink href="/staff"><i class="fa-solid fa-id-card fa-fw text-white/60" aria-hidden="true"></i><span>Staff</span></NavLink></li>
        <li><NavLink href="/shop"><i class="fa-solid fa-store fa-fw text-white/60" aria-hidden="true"></i><span>Shops</span></NavLink></li>
        <li><NavLink href="/tax"><i class="fa-solid fa-percent fa-fw text-white/60" aria-hidden="true"></i><span>Tax rules</span></NavLink></li>
        <li><NavLink href="/state"><i class="fa-solid fa-map fa-fw text-white/60" aria-hidden="true"></i><span>States</span></NavLink></li>
        <li><NavLink href="/township"><i class="fa-solid fa-location-dot fa-fw text-white/60" aria-hidden="true"></i><span>Townships</span></NavLink></li>
        <li class="menu-title mt-3 text-white/45">Insights</li>
        <li><NavLink href="/report"><i class="fa-solid fa-chart-line fa-fw text-white/60" aria-hidden="true"></i><span>Reports</span></NavLink></li>
    </text>;
}
