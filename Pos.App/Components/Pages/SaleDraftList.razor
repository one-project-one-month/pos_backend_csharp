@page "/sale-drafts"
@attribute [Authorize]
@inject BackendApiClient Api

<PageTitle>Sale drafts · POS Ledger</PageTitle>
<FlashAlert />

<header class="mb-7 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div><p class="page-kicker">Persistent carts</p><h1 class="page-title">Sale drafts</h1><p class="mt-2 text-base-content/65">Open several sales and return to any of them later.</p></div>
    <a class="btn btn-warning" href="/sale-drafts/create">New draft</a>
</header>

<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    @if (Drafts.Count == 0)
    {
        <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-10 text-center md:col-span-2 xl:col-span-3">
            <h2 class="text-xl font-black">No open drafts</h2><p class="mt-2 text-base-content/60">Start a sale when the next customer is ready.</p>
        </div>
    }
    @foreach (var draft in Drafts)
    {
        <article class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
            <div class="flex items-start justify-between gap-4"><div><p class="font-mono text-[10px] uppercase tracking-[.16em] text-primary">DRAFT @draft.SaleDraftId</p><h2 class="mt-1 text-xl font-black">@draft.DraftName</h2></div><span class="badge badge-neutral">@draft.ItemCount items</span></div>
            <p class="mt-6 text-3xl font-black">@draft.TotalAmount.ToString("N2")</p>
            <p class="mt-1 text-xs text-base-content/50">Updated @draft.UpdatedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</p>
            <div class="mt-5 flex justify-between"><a class="btn btn-primary btn-sm" href="/sale-drafts/@draft.SaleDraftId">Resume</a><a class="btn btn-ghost btn-sm text-error" href="/sale-drafts/@draft.SaleDraftId/delete">Delete</a></div>
        </article>
    }
</section>

@code {
    private IReadOnlyList<SaleDraftSummaryModel> Drafts { get; set; } = [];
    protected override async Task OnInitializedAsync() => Drafts = await Api.GetFromJsonAsync<List<SaleDraftSummaryModel>>("api/v1/sale-drafts") ?? [];
}
