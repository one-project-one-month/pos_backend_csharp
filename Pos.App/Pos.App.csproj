<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pos.BackendApi.Models\Pos.BackendApi.Models.csproj" />
  </ItemGroup>

  <Target Name="RestoreFrontendDependencies"
          BeforeTargets="Build"
          Inputs="package-lock.json"
          Outputs="node_modules\.package-lock.json">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="BuildFrontendStyles"
          BeforeTargets="Build;Publish"
          DependsOnTargets="RestoreFrontendDependencies"
          Inputs="Styles\app.css;package-lock.json;@(RazorComponent)"
          Outputs="wwwroot\css\site.generated.css">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
